<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (One UI 4+): tela de abertura (splash) do sistema.
  Um tema por qualificador NÃO herda itens do tema padrão, então os itens
  comuns são repetidos aqui + os exclusivos do 31.
-->
<resources>
    <style name="Theme.CountdownGeek" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/tema_fundo</item>
        <item name="android:colorAccent">@color/destaque</item>
        <item name="android:colorControlActivated">@color/destaque</item>
        <item name="android:statusBarColor">@color/tema_fundo</item>
        <item name="android:navigationBarColor">@color/tema_fundo</item>

        <!-- Foguete branco do ícone sobre o roxo: mesma cara do ícone do launcher. -->
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
